+    // expected.  Local RTSP camera is unaffected: it uses a separate branch
+    // in MediaPlayCtrl::Play() that constructs bambu:///local/ / rtsps / rtsp
+    // URLs from printer-side MQTT data and returns before reaching this call.
+    (void)dev_id;
+    (void)callback;
+    return 0;
